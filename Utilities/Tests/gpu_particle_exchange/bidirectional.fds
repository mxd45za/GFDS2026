&HEAD CHID='bidirectional', TITLE='Two-way migration through three meshes, two liquid classes' /
&MESH IJK=10,4,4, XB=0,1,0,1,0,1 /
&MESH IJK=10,4,4, XB=1,2,0,1,0,1 /
&MESH IJK=10,4,4, XB=2,3,0,1,0,1 /
&TIME T_END=0.15, DT=0.002 /
&MISC SIMULATION_MODE='VLES', NOISE=.FALSE., GVEC=0,0,0 /
&RADI RADIATION=.FALSE. /
&DUMP DT_PART=0.01, DT_DEVC=0.01 /
&SPEC ID='WATER VAPOR' /
&PART ID='drops_a', SPEC_ID='WATER VAPOR', DIAMETER=3000, MONODISPERSE=.TRUE., SAMPLING_FACTOR=1,
      HEAT_TRANSFER_COEFFICIENT_GAS=0, MASS_TRANSFER_COEFFICIENT=0,
      QUANTITIES='PARTICLE MASS','PARTICLE WEIGHTING FACTOR','PARTICLE TEMPERATURE','PARTICLE U' /
&PART ID='drops_b', SPEC_ID='WATER VAPOR', DIAMETER=4000, MONODISPERSE=.TRUE., SAMPLING_FACTOR=1,
      HEAT_TRANSFER_COEFFICIENT_GAS=0, MASS_TRANSFER_COEFFICIENT=0,
      QUANTITIES='PARTICLE MASS','PARTICLE WEIGHTING FACTOR','PARTICLE TEMPERATURE','PARTICLE U' /
&INIT ID='right_a', XYZ=0.95,0.3,0.5, UVW=5,0,0, N_PARTICLES=20, PART_ID='drops_a' /
&INIT ID='left_b', XYZ=1.05,0.3,0.5, UVW=-5,0,0, N_PARTICLES=21, PART_ID='drops_b' /
&INIT ID='right_b', XYZ=1.95,0.7,0.5, UVW=5,0,0, N_PARTICLES=22, PART_ID='drops_b' /
&INIT ID='left_a', XYZ=2.05,0.7,0.5, UVW=-5,0,0, N_PARTICLES=23, PART_ID='drops_a' /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMIN', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&TAIL /
