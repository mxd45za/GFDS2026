&HEAD CHID='reinsertion', TITLE='Repeated insertion after migration, without per-step particle output' /
&MESH IJK=10,4,4, XB=0,1,0,1,0,1 /
&MESH IJK=10,4,4, XB=1,2,0,1,0,1 /
&TIME T_END=0.15, DT=0.002 /
&MISC SIMULATION_MODE='VLES', NOISE=.FALSE., GVEC=0,0,0 /
&RADI RADIATION=.FALSE. /
&DUMP DT_PART=0.05, DT_DEVC=0.05 /
&SPEC ID='WATER VAPOR' /
&PART ID='drops', SPEC_ID='WATER VAPOR', DIAMETER=3000, MONODISPERSE=.TRUE., SAMPLING_FACTOR=1,
      HEAT_TRANSFER_COEFFICIENT_GAS=0, MASS_TRANSFER_COEFFICIENT=0,
      QUANTITIES='PARTICLE MASS','PARTICLE WEIGHTING FACTOR','PARTICLE TEMPERATURE','PARTICLE U' /
&INIT ID='continuous', XYZ=0.95,0.5,0.5, UVW=5,0,0, N_PARTICLES=4, PART_ID='drops',
      MASS_PER_TIME=0.001, DT_INSERT=0.02 /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMIN', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&TAIL /
