&HEAD CHID='removal', TITLE='Device-side lifetime and out-of-domain removal' /
&MESH IJK=10,4,4, XB=0,1,0,1,0,1 /
&MESH IJK=10,4,4, XB=1,2,0,1,0,1 /
&TIME T_END=0.1, DT=0.002 /
&MISC SIMULATION_MODE='VLES', NOISE=.FALSE., GVEC=0,0,0 /
&RADI RADIATION=.FALSE. /
&DUMP DT_PART=0.01, DT_DEVC=0.01 /
&SPEC ID='WATER VAPOR' /
&PART ID='expire', SPEC_ID='WATER VAPOR', DIAMETER=3000, MONODISPERSE=.TRUE., SAMPLING_FACTOR=1, AGE=0.03,
      HEAT_TRANSFER_COEFFICIENT_GAS=0, MASS_TRANSFER_COEFFICIENT=0,
      QUANTITIES='PARTICLE MASS','PARTICLE WEIGHTING FACTOR' /
&PART ID='leave', SPEC_ID='WATER VAPOR', DIAMETER=3000, MONODISPERSE=.TRUE., SAMPLING_FACTOR=1,
      HEAT_TRANSFER_COEFFICIENT_GAS=0, MASS_TRANSFER_COEFFICIENT=0,
      QUANTITIES='PARTICLE MASS','PARTICLE WEIGHTING FACTOR' /
&INIT XYZ=0.95,0.3,0.5, UVW=5,0,0, N_PARTICLES=8, PART_ID='expire' /
&INIT XYZ=1.85,0.7,0.5, UVW=5,0,0, N_PARTICLES=8, PART_ID='leave' /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMIN', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&TAIL /
