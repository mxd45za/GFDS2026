&DEVC ID='W_X_25', QUANTITY='W-VELOCITY', XYZ=0.081667,0.05,0.05 /
&DEVC ID='W_X_26', QUANTITY='W-VELOCITY', XYZ=0.085000,0.05,0.05 /
&DEVC ID='W_X_27', QUANTITY='W-VELOCITY', XYZ=0.088333,0.05,0.05 /
&DEVC ID='W_X_28', QUANTITY='W-VELOCITY', XYZ=0.091667,0.05,0.05 /
&DEVC ID='W_X_29', QUANTITY='W-VELOCITY', XYZ=0.095000,0.05,0.05 /
&DEVC ID='W_X_30', QUANTITY='W-VELOCITY', XYZ=0.098333,0.05,0.05 /
! ------------------------------------------------------------
&BNDF QUANTITY='CONVECTIVE HEAT FLUX' /


! End
! ------------------------------------------------------------
&TAIL /
