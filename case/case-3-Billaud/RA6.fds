&DEVC ID='U_Z_30', QUANTITY='U-VELOCITY', XYZ=0.05,0.05,0.098333 /

! ------------------------------------------------------------
! Horizontal centerline: W(x)
! y = 0.05, z = 0.05, x = cell centers
! ------------------------------------------------------------
&DEVC ID='W_X_01', QUANTITY='W-VELOCITY', XYZ=0.001667,0.05,0.05 /
&DEVC ID='W_X_02', QUANTITY='W-VELOCITY', XYZ=0.005000,0.05,0.05 /
&DEVC ID='W_X_03', QUANTITY='W-VELOCITY', XYZ=0.008333,0.05,0.05 /
&DEVC ID='W_X_04', QUANTITY='W-VELOCITY', XYZ=0.011667,0.05,0.05 /
&DEVC ID='W_X_05', QUANTITY='W-VELOCITY', XYZ=0.015000,0.05,0.05 /
&DEVC ID='W_X_06', QUANTITY='W-VELOCITY', XYZ=0.018333,0.05,0.05 /
&DEVC ID='W_X_07', QUANTITY='W-VELOCITY', XYZ=0.021667,0.05,0.05 /
&DEVC ID='W_X_08', QUANTITY='W-VELOCITY', XYZ=0.025000,0.05,0.05 /
&DEVC ID='W_X_09', QUANTITY='W-VELOCITY', XYZ=0.028333,0.05,0.05 /
&DEVC ID='W_X_10', QUANTITY='W-VELOCITY', XYZ=0.031667,0.05,0.05 /
