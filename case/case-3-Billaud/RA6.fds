&DEVC ID='W_X_13', QUANTITY='W-VELOCITY', XYZ=0.041667,0.05,0.05 /
&DEVC ID='W_X_14', QUANTITY='W-VELOCITY', XYZ=0.045000,0.05,0.05 /
&DEVC ID='W_X_15', QUANTITY='W-VELOCITY', XYZ=0.048333,0.05,0.05 /
&DEVC ID='W_X_16', QUANTITY='W-VELOCITY', XYZ=0.051667,0.05,0.05 /
&DEVC ID='W_X_17', QUANTITY='W-VELOCITY', XYZ=0.055000,0.05,0.05 /
&DEVC ID='W_X_18', QUANTITY='W-VELOCITY', XYZ=0.058333,0.05,0.05 /
&DEVC ID='W_X_19', QUANTITY='W-VELOCITY', XYZ=0.061667,0.05,0.05 /
&DEVC ID='W_X_20', QUANTITY='W-VELOCITY', XYZ=0.065000,0.05,0.05 /
&DEVC ID='W_X_21', QUANTITY='W-VELOCITY', XYZ=0.068333,0.05,0.05 /
&DEVC ID='W_X_22', QUANTITY='W-VELOCITY', XYZ=0.071667,0.05,0.05 /
&DEVC ID='W_X_23', QUANTITY='W-VELOCITY', XYZ=0.075000,0.05,0.05 /
