&HEAD CHID='SC_20_1', TITLE='Solar Chimney p1_p1_30 performance case' /
&TIME T_END=100. /
&DUMP DT_DEVC=100. /

! 60 x 60 x 56 = 201,600 cells
&MESH IJK=60,60,56, XB=0.00,2.00,-0.90,0.90,0.00,2.20 /

&SURF ID='HOT', COLOR='RED', TMP_FRONT=30. /
&SURF ID='WALL', ADIABATIC=.TRUE., DEFAULT=.TRUE. /
&OBST XB=0.00,1.70,-0.90,0.90,2.00,2.20, SURF_ID6='WALL','OPEN','WALL','WALL','WALL','WALL' /
&OBST XB=1.65,1.80,-0.90,0.90,0.10,2.00 /
&OBST XB=1.90,2.00,-0.90,0.90,0.00,2.00 /
&OBST XB=1.80,1.90,-0.90,-0.75,0.00,2.00 /
&OBST XB=1.80,1.90,0.75,0.90,0.00,2.00 /
&OBST XB=1.65,1.80,-0.90,-0.70,0.00,0.10 /
&OBST XB=1.65,1.80,0.70,0.90,0.00,0.10 /
&VENT XB=1.80,1.80,-0.75,0.75,0.10,2.00, SURF_ID='HOT', IOR=1 /
&VENT XB=1.90,1.90,-0.75,0.75,0.00,2.00, SURF_ID='HOT', IOR=-1 /
&VENT XB=0.0,0.0,-0.25,0.25,0.7,1.3, SURF_ID='OPEN' /
&VENT XB=1.7,3.0,-0.9,-0.9,2.0,2.2, SURF_ID='OPEN' /
&VENT XB=1.7,3.0,0.9,0.9,2.0,2.2, SURF_ID='OPEN' /
&VENT XB=2.0,2.0,-0.9,0.9,2.0,2.2, SURF_ID='OPEN' /
&VENT XB=1.7,3.0,-0.9,0.9,2.2,2.2, SURF_ID='OPEN' /
&DEVC ID='mdot', QUANTITY='MASS FLUX X', SPATIAL_STATISTIC='AREA INTEGRAL', XB=1.75,1.75,-0.70,0.70,0.00,0.10 /
&TAIL /
