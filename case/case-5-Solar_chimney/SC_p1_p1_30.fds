&HEAD CHID='SC_p1_p1_30', TITLE='Solar Chimney, inlet height, cavity width, temperature'/

&TIME T_END=100. /
&DUMP DT_DEVC=1. /

&MESH IJK= 6,56, 4, XB=1.65,1.80,-0.70,0.70,0.0,0.1 / Inlet slot
&MESH IJK= 4,60,80, XB=1.80,1.90,-0.75,0.75,0.0,2.0 / Hot cavity
&MESH IJK=12,72, 8, XB=1.70,2.00,-0.90,0.90,2.0,2.2 / Cavity exit
&MESH IJK=33,36,40, XB=0.00,1.65,-0.90,0.90,0.0,2.0 / Upstream room

&SURF ID='HOT', COLOR='RED', TMP_FRONT=30. /
&SURF ID='WALL', ADIABATIC=.TRUE., DEFAULT=.TRUE. /

&VENT XB= 1.80, 1.80,-0.75, 0.75,0.10,2.00, SURF_ID='HOT' / Left hot panel
&VENT XB= 1.90, 1.90,-0.75, 0.75,0.00,2.00, SURF_ID='HOT' / Right hot panel

&VENT XB= 0.0,0.0,-0.25,0.25,0.7,1.3, SURF_ID='OPEN' / Window

&VENT XB=1.7,3.0,-0.9,-0.9,2.0,2.2, SURF_ID='OPEN' / Cavity exit, front
&VENT XB=1.7,3.0, 0.9, 0.9,2.0,2.2, SURF_ID='OPEN' / Cavity exit, back 
&VENT XB=1.7,1.7,-0.9, 0.9,2.0,2.2, SURF_ID='OPEN' / Cavity exit, left
&VENT XB=2.0,2.0,-0.9, 0.9,2.0,2.2, SURF_ID='OPEN' / Cavity exit, right
&VENT XB=1.7,3.0,-0.9, 0.9,2.2,2.2, SURF_ID='OPEN' / Cavity exit, top

&DEVC ID='mdot', QUANTITY='MASS FLUX X', SPATIAL_STATISTIC='AREA INTEGRAL', XB=1.75,1.75,-0.70,0.70,0.00,0.10 /
&DEVC ID='hdot', QUANTITY='ENTHALPY FLUX Z', SPATIAL_STATISTIC='AREA INTEGRAL', XB=1.80,1.90,-0.75,0.75,1.99,1.99 /

&DEVC ID='T_CAV_Z025', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,0.25,0.25 /
&DEVC ID='W_CAV_Z025', QUANTITY='W-VELOCITY', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,0.25,0.25 /
&DEVC ID='RHO_CAV_Z025', QUANTITY='DENSITY', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,0.25,0.25 /
&DEVC ID='P_CAV_Z025', QUANTITY='PRESSURE', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,0.25,0.25 /
&DEVC ID='P_ROOM_Z025', QUANTITY='PRESSURE', SPATIAL_STATISTIC='MEAN', XB=0.00,1.65,-0.90,0.90,0.25,0.25 /

&DEVC ID='T_CAV_Z050', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,0.50,0.50 /
&DEVC ID='W_CAV_Z050', QUANTITY='W-VELOCITY', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,0.50,0.50 /
&DEVC ID='RHO_CAV_Z050', QUANTITY='DENSITY', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,0.50,0.50 /
&DEVC ID='P_CAV_Z050', QUANTITY='PRESSURE', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,0.50,0.50 /
&DEVC ID='P_ROOM_Z050', QUANTITY='PRESSURE', SPATIAL_STATISTIC='MEAN', XB=0.00,1.65,-0.90,0.90,0.50,0.50 /

&DEVC ID='T_CAV_Z100', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.00,1.00 /
&DEVC ID='W_CAV_Z100', QUANTITY='W-VELOCITY', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.00,1.00 /
&DEVC ID='RHO_CAV_Z100', QUANTITY='DENSITY', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.00,1.00 /
&DEVC ID='P_CAV_Z100', QUANTITY='PRESSURE', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.00,1.00 /
&DEVC ID='P_ROOM_Z100', QUANTITY='PRESSURE', SPATIAL_STATISTIC='MEAN', XB=0.00,1.65,-0.90,0.90,1.00,1.00 /

&DEVC ID='T_CAV_Z150', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.50,1.50 /
&DEVC ID='W_CAV_Z150', QUANTITY='W-VELOCITY', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.50,1.50 /
&DEVC ID='RHO_CAV_Z150', QUANTITY='DENSITY', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.50,1.50 /
&DEVC ID='P_CAV_Z150', QUANTITY='PRESSURE', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.50,1.50 /
&DEVC ID='P_ROOM_Z150', QUANTITY='PRESSURE', SPATIAL_STATISTIC='MEAN', XB=0.00,1.65,-0.90,0.90,1.50,1.50 /

&DEVC ID='T_CAV_Z190', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.90,1.90 /
&DEVC ID='W_CAV_Z190', QUANTITY='W-VELOCITY', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.90,1.90 /
&DEVC ID='RHO_CAV_Z190', QUANTITY='DENSITY', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.90,1.90 /
&DEVC ID='P_CAV_Z190', QUANTITY='PRESSURE', SPATIAL_STATISTIC='MEAN', XB=1.80,1.90,-0.75,0.75,1.90,1.90 /
&DEVC ID='P_ROOM_Z190', QUANTITY='PRESSURE', SPATIAL_STATISTIC='MEAN', XB=0.00,1.65,-0.90,0.90,1.90,1.90 /

&SLCF PBY=0.000, QUANTITY='TEMPERATURE', VECTOR=.TRUE. /
&SLCF PBY=0.000, QUANTITY='VELOCITY', VECTOR=.TRUE. /
&SLCF PBY=0.000, QUANTITY='PRESSURE' /
&TAIL /
